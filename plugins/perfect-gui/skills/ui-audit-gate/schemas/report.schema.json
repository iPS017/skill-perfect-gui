{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui-audit-gate report",
  "type": "object",
  "required": ["run_id", "level", "mode", "research", "controls", "decision"],
  "properties": {
    "run_id": {"type": "string"},
    "title": {"type": "string"},
    "trigger": {"enum": ["C1", "C2", "C3"]},
    "level": {"enum": ["N1", "N2", "N3"]},
    "computed_level": {"enum": ["N1", "N2", "N3"]},
    "reduced_coverage": {"type": "boolean"},
    "reduction_justification": {"type": ["string", "null"]},
    "mode": {"enum": ["full", "mockup", "no_execution"]},
    "baseline": {"enum": ["before", "first-render", "unavailable"]},
    "research": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["done", "partial", "not_done"]},
        "cause": {"type": ["string", "null"]}
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "observation", "principle", "gap", "adaptation", "benefit", "nature"]
      }
    },
    "visual_change": {"type": "boolean"},
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not_verified", "not_applicable"]},
          "nature": {"type": "array", "items": {"enum": ["visual", "structural", "behavioral", "assistive", "human"]}},
          "configs": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"},
          "reason_type": {"enum": ["technical", "human", "real_device", "out_of_scope", "other"]}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "fixes": {"type": "array"},
    "before_after": {
      "type": "array",
      "items": {"type": "object", "required": ["after"], "properties": {"config_id": {"type": "string"}, "before": {"type": "string"}, "after": {"type": "string"}, "diff": {"type": "string"}, "comment": {"type": "string"}}}
    },
    "decision": {"enum": [null, "VALIDATED_FULL_PROTOCOL", "VALIDATED_TESTED_SCOPE", "VALIDATED_WITH_EXCEPTIONS", "NOT_VALIDATED", "LIMITED_VALIDATION"]}
  }
}
