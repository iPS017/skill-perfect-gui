{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui-audit-gate finding record",
  "type": "object",
  "required": ["id", "title", "control", "severity", "priority", "confidence", "nature", "status", "expected", "observed", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^DEF-[0-9]{3,}$"},
    "title": {"type": "string"},
    "control": {"type": "string", "description": "Matrix identifier, for example CTA-01, or PRJ-xx"},
    "screen_component": {"type": "string"},
    "preconditions": {"type": "string"},
    "data": {"type": "string"},
    "config_id": {"type": "string"},
    "steps": {"type": "array", "items": {"type": "string"}},
    "expected": {"type": "string"},
    "observed": {"type": "string", "description": "Facts and measurements only"},
    "interpretation": {"type": "string", "description": "Presumed cause, kept separate from the observed facts"},
    "nature": {"enum": ["REQUIREMENT", "HYPOTHESIS", "PREFERENCE"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "reproductions": {"type": "string"},
    "severity": {"enum": ["critical", "major", "moderate", "minor"]},
    "priority": {"enum": ["P1", "P2", "P3"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "effort": {"enum": ["S", "M", "L"]},
    "status": {"enum": ["open", "fixed", "failed_unresolved", "accepted_exception"]},
    "introduced_by_fix": {"type": "boolean"},
    "retest": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_verified"]},
        "config_id": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exception": {
      "type": ["object", "null"],
      "required": ["accepted_by", "date", "quote"],
      "properties": {
        "accepted_by": {"type": "string"},
        "date": {"type": "string"},
        "quote": {"type": "string", "description": "The words of the user who accepts the exception"},
        "due": {"type": "string"}
      }
    },
    "blocking_cause": {"type": ["string", "null"]},
    "required_action": {"type": ["string", "null"]}
  }
}
